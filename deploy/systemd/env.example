# Dinotty 环境变量配置
# 复制此文件到 /etc/dinotty/env 并按需修改

# 服务端口（默认 8999）
DINOTTY_PORT=8999

# 监听地址（默认仅本机；局域网访问需显式改为 0.0.0.0）
DINOTTY_BIND_ADDR=127.0.0.1

# 认证 Token（留空则启动时自动生成随机 Token）
DINOTTY_TOKEN=

# 日志级别: trace, debug, info, warn, error
RUST_LOG=info

# 默认 Shell（系统服务用户 SHELL 通常为 nologin，需显式设置）
SHELL=/bin/bash
